# 统一换行符：仓库里一律按 LF 存储，检出时也不转换。
# 不加这个的话，Windows 上每次操作都会刷一屏 "LF will be replaced by CRLF" 警告，
# 而且不同系统协作时容易出现整文件 diff。
* text=auto eol=lf

# 明确按文本处理（方便 GitHub 正确统计语言、正确显示 diff）
*.py     text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# 二进制文件不做任何换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
*.zip    binary
*.exe    binary
*.dll    binary
*.so     binary
*.pyc    binary
