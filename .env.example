# ============================================================
#  环境变量模板（.env.example）
# ------------------------------------------------------------
#  使用方法：
#     1. 把本文件复制一份，重命名为 .env（去掉 .example 后缀）
#           Windows:  copy .env.example .env
#           macOS/Linux:  cp .env.example .env
#     2. 打开 .env，按下面的说明把值改成你自己的。
#
#  .env 已被 .gitignore 排除，写了什么都不会被提交到 GitHub。
#  本文件（.env.example）会提交，所以这里只能放占位值，
#  绝对不要把真实密码/密钥写进这个文件。
#
#  也可以不建 .env，直接设置系统环境变量；两者的名字完全一样。
#  优先级：系统环境变量 > .env 文件 > config.py 里的默认值。
# ============================================================


# ---------- 一、MySQL 数据库 ----------

# 数据库地址，本机安装就保持 127.0.0.1
LDGS_DB_HOST=127.0.0.1

# 端口，MySQL 默认 3306
LDGS_DB_PORT=3306

# 登录用户
LDGS_DB_USER=root

# 登录密码 ★必填★
# 这一项没有默认值，留空会连不上数据库。
# 密码里如果含 # 号，请用英文引号包起来，例如 LDGS_DB_PASSWORD="ab#123"
LDGS_DB_PASSWORD=

# 数据库名，和 sql/01_schema.sql 里创建的名字保持一致
LDGS_DB_NAME=algorithm_ldgs

# 连接超时秒数
LDGS_DB_TIMEOUT=8


# ---------- 二、HTTP 服务 ----------

# 监听地址。127.0.0.1 只允许本机访问，最安全
LDGS_HOST=127.0.0.1

# 监听端口，被占用时换一个即可
LDGS_PORT=8000


# ---------- 三、推理机 ----------

# 单次推理的最大轮次，只是防止死循环的保险值，正常用不到
LDGS_MAX_ROUNDS=200


# ---------- 四、知识源 ----------

# db   = 从 MySQL 读取（默认，功能完整，可增删改规则）
# file = 从内置知识文件读取（免数据库，规则只读）
LDGS_KNOWLEDGE_SOURCE=db


# ---------- 五、外部服务密钥 ★以后要用再加★ ----------
# 下面这些现在用不到，留空即可。
# 之所以先写在这里，是因为 .env 本来就不会入库；
# 将来要接大模型 API 之类的服务时，把 key 填在这个文件里
# （或者设为系统环境变量），就绝不会被提交。
#
# 切记：不要把 key 直接写进任何 .py 文件。
#
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
